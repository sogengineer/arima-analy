language js

// src/domain 配下では「現在時刻」への暗黙依存を禁止する。
// 基準日（asOf）を引数で受け取り、純粋な計算に保つため。
or {
  `new Date()` as $d where {
    register_diagnostic(
      span = $d,
      message = "domain 層では引数なしの new Date() を使わない。基準日を引数で受け取ること。",
      severity = "error"
    )
  },
  `Date.now()` as $d where {
    register_diagnostic(
      span = $d,
      message = "domain 層では Date.now() を使わない。基準日を引数で受け取ること。",
      severity = "error"
    )
  }
}
