language js

// 内部モジュールの import に拡張子は付けない（プロジェクトの多数派に合わせる）。
// Bun は拡張子なしの TS 解決に対応しているため、.js を付けると表記が混在する。
// 対象は `./` の相対 import とパスエイリアス `@/` の両方。
or {
  `import $_ from $src` as $d where {
    $src <: r"['\"](?:\.|@/)[^'\"]*\.js['\"]",
    register_diagnostic(
      span = $d,
      message = "内部モジュールの import に .js 拡張子を付けない（プロジェクトの多数派は拡張子なし）。",
      severity = "error"
    )
  },
  `import $src` as $d where {
    $src <: r"['\"](?:\.|@/)[^'\"]*\.js['\"]",
    register_diagnostic(
      span = $d,
      message = "内部モジュールの import に .js 拡張子を付けない（プロジェクトの多数派は拡張子なし）。",
      severity = "error"
    )
  }
}
